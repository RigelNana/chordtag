{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rigelnana.github.io/chordtag/chordtag-annotation.schema.json",
  "title": "ChordTag Annotation Standard",
  "description": "A transportable, time-based chord annotation format with meter and tempo changes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "metadata",
    "musicalContext",
    "timeline",
    "annotations"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "format": {
      "const": "ChordTag Annotation Standard"
    },
    "version": {
      "const": "1.0.0"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "duration", "createdAt"],
      "properties": {
        "title": { "type": "string" },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "createdAt": { "type": "string", "format": "date-time" },
        "audioHash": {
          "description": "Optional SHA-256 digest used to bind annotations to an audio asset.",
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "musicalContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tonic", "mode", "keyMap"],
      "properties": {
        "tonic": {
          "type": "string",
          "pattern": "^[A-G](?:#|b)?$"
        },
        "mode": {
          "enum": [
            "major",
            "minor",
            "dorian",
            "phrygian",
            "lydian",
            "mixolydian",
            "locrian",
            "harmonic minor",
            "melodic minor"
          ]
        },
        "keyMap": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["startBar", "startTime", "tonic", "mode"],
            "properties": {
              "startBar": { "type": "integer", "minimum": 1 },
              "startTime": { "type": "number", "minimum": 0 },
              "tonic": { "type": "string", "pattern": "^[A-G](?:#|b)?$" },
              "mode": {
                "enum": [
                  "major",
                  "minor",
                  "dorian",
                  "phrygian",
                  "lydian",
                  "mixolydian",
                  "locrian",
                  "harmonic minor",
                  "melodic minor"
                ]
              }
            }
          }
        }
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "volume", "muted", "solo"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "volume": { "type": "number", "minimum": 0, "maximum": 1 },
          "muted": { "type": "boolean" },
          "solo": { "type": "boolean" }
        }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["firstBeatOffset", "tempoMap"],
      "properties": {
        "firstBeatOffset": {
          "description": "Seconds from audio start to bar 1 beat 1.",
          "type": "number",
          "minimum": 0
        },
        "tempoMap": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["startTime", "startBar", "bpm", "numerator", "denominator"],
            "properties": {
              "startTime": { "type": "number", "minimum": 0 },
              "startBar": { "type": "integer", "minimum": 1 },
              "bpm": { "type": "number", "exclusiveMinimum": 0 },
              "numerator": { "type": "integer", "minimum": 1 },
              "denominator": { "enum": [1, 2, 4, 8, 16, 32] }
            }
          }
        }
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "start",
          "end",
          "symbol",
          "root",
          "quality",
          "bass",
          "romanNumeral",
          "confidence"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "exclusiveMinimum": 0 },
          "symbol": { "type": "string", "minLength": 1 },
          "root": {
            "type": "string",
            "pattern": "^[A-G](?:#|b)?$"
          },
          "quality": {
            "description": "A Tonal ChordType alias. Consumers should resolve it with @tonaljs/chord-type.",
            "type": "string",
            "minLength": 1
          },
          "bass": {
            "type": ["string", "null"],
            "pattern": "^[A-G](?:#|b)?$"
          },
          "romanNumeral": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "trackId": { "type": "string", "minLength": 1 },
          "voicing": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[A-G](?:#|b)?-?\\d+$" }
          },
          "velocity": { "type": "number", "minimum": 0, "maximum": 1 },
          "keyContext": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tonic", "mode", "startBar"],
            "properties": {
              "tonic": { "type": "string", "pattern": "^[A-G](?:#|b)?$" },
              "mode": {
                "enum": [
                  "major",
                  "minor",
                  "dorian",
                  "phrygian",
                  "lydian",
                  "mixolydian",
                  "locrian",
                  "harmonic minor",
                  "melodic minor"
                ]
              },
              "startBar": { "type": "integer", "minimum": 1 }
            }
          },
          "harmonicAnalysis": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "classification",
              "diatonic",
              "chordToneCoverage",
              "borrowedFrom",
              "secondaryTarget"
            ],
            "properties": {
              "classification": { "type": "string" },
              "diatonic": { "type": "boolean" },
              "chordToneCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
              "borrowedFrom": {
                "type": "array",
                "items": {
                  "enum": [
                    "major",
                    "minor",
                    "dorian",
                    "phrygian",
                    "lydian",
                    "mixolydian",
                    "locrian",
                    "harmonic minor",
                    "melodic minor"
                  ]
                }
              },
              "secondaryTarget": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  }
}

