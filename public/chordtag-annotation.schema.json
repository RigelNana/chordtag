{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rigelnana.github.io/chordtag/chordtag-annotation.schema.json",
  "title": "ChordTag Annotation Standard",
  "description": "A transportable, time-based chord annotation format with meter and tempo changes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "metadata",
    "musicalContext",
    "timeline",
    "annotations"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "format": {
      "const": "ChordTag Annotation Standard"
    },
    "version": {
      "const": "1.0.0"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "duration", "createdAt"],
      "properties": {
        "title": { "type": "string" },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "createdAt": { "type": "string", "format": "date-time" },
        "audioHash": {
          "description": "Optional SHA-256 digest used to bind annotations to an audio asset.",
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "musicalContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tonic", "mode"],
      "properties": {
        "tonic": {
          "type": "string",
          "pattern": "^[A-G](?:#|b)?$"
        },
        "mode": {
          "enum": ["major", "minor"]
        }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["firstBeatOffset", "tempoMap"],
      "properties": {
        "firstBeatOffset": {
          "description": "Seconds from audio start to bar 1 beat 1.",
          "type": "number",
          "minimum": 0
        },
        "tempoMap": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["startTime", "startBar", "bpm", "numerator", "denominator"],
            "properties": {
              "startTime": { "type": "number", "minimum": 0 },
              "startBar": { "type": "integer", "minimum": 1 },
              "bpm": { "type": "number", "exclusiveMinimum": 0 },
              "numerator": { "type": "integer", "minimum": 1 },
              "denominator": { "enum": [1, 2, 4, 8, 16, 32] }
            }
          }
        }
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "start",
          "end",
          "symbol",
          "root",
          "quality",
          "bass",
          "romanNumeral",
          "confidence"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "exclusiveMinimum": 0 },
          "symbol": { "type": "string", "minLength": 1 },
          "root": {
            "type": "string",
            "pattern": "^[A-G](?:#|b)?$"
          },
          "quality": {
            "enum": [
              "maj",
              "min",
              "5",
              "7",
              "maj7",
              "m7",
              "mMaj7",
              "sus2",
              "sus4",
              "dim",
              "dim7",
              "m7b5",
              "aug",
              "add9",
              "madd9",
              "add11",
              "madd11",
              "6",
              "m6",
              "6/9",
              "m6/9",
              "7sus4",
              "9",
              "maj9",
              "m9",
              "9sus4",
              "11",
              "maj11",
              "m11",
              "13",
              "maj13",
              "m13",
              "7b5",
              "7#5",
              "7b9",
              "7#9",
              "7#5b9",
              "7#5#9",
              "maj7#11",
              "m11b5"
            ]
          },
          "bass": {
            "type": ["string", "null"],
            "pattern": "^[A-G](?:#|b)?$"
          },
          "romanNumeral": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}

